{
  "rules": {
    "juegos": { "$juego": { "salas": { "$sala": { ".read": true, ".write": true } } } },
    "actividad": {
      ".read": true,
      "$juego": { "$sala": { ".write": true, ".validate": "newData.isNumber()" } }
    },
    "mazos": { ".read": true, ".write": true },
    "usuarios": {
      ".read": true,
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    }
  }
}
